<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_LeaveApproval"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.20.0">
  <bpmn:process id="Process_EmployeeLeaveApproval" name="Employee Leave Approval Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_LeaveRequested" name="Employee Submits Leave Request">
      <bpmn:outgoing>Flow_Start_ToCheck</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:serviceTask id="Task_CheckBalance" name="Check Leave Balance" camunda:type="external" camunda:topic="check-leave-balance">
      <bpmn:incoming>Flow_Start_ToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckToGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_BalanceCheck" name="Sufficient Leave Balance?">
      <bpmn:incoming>Flow_CheckToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_BalanceInsufficient</bpmn:outgoing>
      <bpmn:outgoing>Flow_BalanceSufficient</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_SendInsufficientNotif" name="Send Insufficient-Balance Notification" camunda:type="external" camunda:topic="send-insufficient-notification">
      <bpmn:incoming>Flow_BalanceInsufficient</bpmn:incoming>
      <bpmn:outgoing>Flow_EndInsufficient</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_InsufficientBalance" name="Request Rejected (Insufficient Balance)">
      <bpmn:incoming>Flow_EndInsufficient</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_ManagerApproval" name="Manager Review &amp; Approval" camunda:candidateGroups="managers">
      <bpmn:incoming>Flow_BalanceSufficient</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ManagerDecision" name="Manager Decision?">
      <bpmn:incoming>Flow_ManagerToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_UpdateBalance" name="Update Employee Leave Balance" camunda:type="external" camunda:topic="update-leave-balance">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateToNotif</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sendTask id="Task_SendApprovalNotif" name="Send Approval Notification" camunda:type="external" camunda:topic="send-approval-notification">
      <bpmn:incoming>Flow_UpdateToNotif</bpmn:incoming>
      <bpmn:outgoing>Flow_EndApproved</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_Approved" name="Leave Approved &#38; Process Ended">
      <bpmn:incoming>Flow_EndApproved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="Task_SendRejectionNotif" name="Send Rejection Notification" camunda:type="external" camunda:topic="send-rejection-notification">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_EndRejected</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_Rejected" name="Leave Rejected &#38; Process Ended">
      <bpmn:incoming>Flow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_ToCheck" sourceRef="StartEvent_LeaveRequested" targetRef="Task_CheckBalance" />
    <bpmn:sequenceFlow id="Flow_CheckToGateway" sourceRef="Task_CheckBalance" targetRef="Gateway_BalanceCheck" />
    <bpmn:sequenceFlow id="Flow_BalanceInsufficient" name="No (Insufficient)" sourceRef="Gateway_BalanceCheck" targetRef="Task_SendInsufficientNotif" />
    <bpmn:sequenceFlow id="Flow_BalanceSufficient" name="Yes (Sufficient)" sourceRef="Gateway_BalanceCheck" targetRef="Task_ManagerApproval" />
    <bpmn:sequenceFlow id="Flow_EndInsufficient" sourceRef="Task_SendInsufficientNotif" targetRef="EndEvent_InsufficientBalance" />
    <bpmn:sequenceFlow id="Flow_ManagerToGateway" sourceRef="Task_ManagerApproval" targetRef="Gateway_ManagerDecision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_ManagerDecision" targetRef="Task_UpdateBalance" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Gateway_ManagerDecision" targetRef="Task_SendRejectionNotif" />
    <bpmn:sequenceFlow id="Flow_UpdateToNotif" sourceRef="Task_UpdateBalance" targetRef="Task_SendApprovalNotif" />
    <bpmn:sequenceFlow id="Flow_EndApproved" sourceRef="Task_SendApprovalNotif" targetRef="EndEvent_Approved" />
    <bpmn:sequenceFlow id="Flow_EndRejected" sourceRef="Task_SendRejectionNotif" targetRef="EndEvent_Rejected" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_LeaveApproval">
    <bpmndi:BPMNPlane id="BPMNPlane_LeaveApproval" bpmnElement="Process_EmployeeLeaveApproval">
      <bpmndi:BPMNShape id="StartEvent_LeaveRequested_di" bpmnElement="StartEvent_LeaveRequested">
        <dc:Bounds x="160" y="210" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckBalance_di" bpmnElement="Task_CheckBalance">
        <dc:Bounds x="250" y="188" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_BalanceCheck_di" bpmnElement="Gateway_BalanceCheck" isMarkerVisible="true">
        <dc:Bounds x="400" y="203" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendInsufficientNotif_di" bpmnElement="Task_SendInsufficientNotif">
        <dc:Bounds x="510" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_InsufficientBalance_di" bpmnElement="EndEvent_InsufficientBalance">
        <dc:Bounds x="670" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManagerApproval_di" bpmnElement="Task_ManagerApproval">
        <dc:Bounds x="510" y="188" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ManagerDecision_di" bpmnElement="Gateway_ManagerDecision" isMarkerVisible="true">
        <dc:Bounds x="660" y="203" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateBalance_di" bpmnElement="Task_UpdateBalance">
        <dc:Bounds x="760" y="188" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendApprovalNotif_di" bpmnElement="Task_SendApprovalNotif">
        <dc:Bounds x="910" y="188" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="1060" y="210" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendRejectionNotif_di" bpmnElement="Task_SendRejectionNotif">
        <dc:Bounds x="760" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="920" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_ToCheck_di" bpmnElement="Flow_Start_ToCheck">
        <di:waypoint x="196" y="228" />
        <di:waypoint x="250" y="228" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CheckToGateway_di" bpmnElement="Flow_CheckToGateway">
        <di:waypoint x="350" y="228" />
        <di:waypoint x="400" y="228" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BalanceInsufficient_di" bpmnElement="Flow_BalanceInsufficient">
        <di:waypoint x="425" y="203" />
        <di:waypoint x="425" y="120" />
        <di:waypoint x="510" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BalanceSufficient_di" bpmnElement="Flow_BalanceSufficient">
        <di:waypoint x="450" y="228" />
        <di:waypoint x="510" y="228" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EndInsufficient_di" bpmnElement="Flow_EndInsufficient">
        <di:waypoint x="610" y="120" />
        <di:waypoint x="670" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerToGateway_di" bpmnElement="Flow_ManagerToGateway">
        <di:waypoint x="610" y="228" />
        <di:waypoint x="660" y="228" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="710" y="228" />
        <di:waypoint x="760" y="228" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="685" y="253" />
        <di:waypoint x="685" y="340" />
        <di:waypoint x="760" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_UpdateToNotif_di" bpmnElement="Flow_UpdateToNotif">
        <di:waypoint x="860" y="228" />
        <di:waypoint x="910" y="228" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EndApproved_di" bpmnElement="Flow_EndApproved">
        <di:waypoint x="1010" y="228" />
        <di:waypoint x="1060" y="228" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EndRejected_di" bpmnElement="Flow_EndRejected">
        <di:waypoint x="860" y="340" />
        <di:waypoint x="920" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

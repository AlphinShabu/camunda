<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_LoanOrigination"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.20.0"
                  modeler:executionPlatform="Camunda Platform"
                  modeler:executionPlatformVersion="7.20.0">
  <bpmn:collaboration id="Collaboration_Loan">
    <bpmn:participant id="Participant_Bank" name="Loan Origination &#38; Approval System" processRef="Process_LoanOriginationApproval" />
  </bpmn:collaboration>

  <bpmn:process id="Process_LoanOriginationApproval" name="Loan Origination &#38; Approval System" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Loan">
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>StartEvent_LoanSubmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResubmitDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcceptOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryTimer_OfferValidity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OfferExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EsignAgreement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LoanOfficer" name="Loan Officer">
        <bpmn:flowNodeRef>Task_ManualKYCVerify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualCreditCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IncomeCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriter" name="Underwriter / Credit Committee">
        <bpmn:flowNodeRef>Task_UnderwriterReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighValueCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SeniorCommitteeApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighValueJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RejectedScore</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Fraud" name="Fraud &#38; Compliance Team">
        <bpmn:flowNodeRef>Task_KYCCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KYCResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FraudInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FraudTerminate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CreditBureau" name="Credit Bureau">
        <bpmn:flowNodeRef>Task_CreditBureau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryError_Bureau</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CoreBanking" name="Core Banking System">
        <bpmn:flowNodeRef>Task_DocCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocCheckResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RiskScoring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskRouting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOffer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Disbursement" name="Operations / Disbursement">
        <bpmn:flowNodeRef>Task_DisburseFunds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LoanDisbursed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- 1. Start & Submission -->
    <bpmn:startEvent id="StartEvent_LoanSubmitted" name="Applicant Submits Loan Application">
      <bpmn:outgoing>Flow_StartToSubmit</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_SubmitApplication" name="Submit Application &#38; Documents" camunda:candidateGroups="applicants">
      <bpmn:incoming>Flow_StartToSubmit</bpmn:incoming>
      <bpmn:incoming>Flow_ResubmittedToDocCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitToDocCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 2. Document Completeness (L1) -->
    <bpmn:businessRuleTask id="Task_DocCheck" name="Check Document Completeness" camunda:decisionRef="check-doc-completeness">
      <bpmn:incoming>Flow_SubmitToDocCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_DocToCheckGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_DocCheckResult" name="Documents Complete?">
      <bpmn:incoming>Flow_DocToCheckGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_DocsComplete</bpmn:outgoing>
      <bpmn:outgoing>Flow_DocsIncomplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- L1: Incomplete Docs -> Resubmission Loop (7d Timer) -->
    <bpmn:userTask id="Task_ResubmitDocs" name="Resubmit Missing Documents (7d Timer)" camunda:candidateGroups="applicants">
      <bpmn:incoming>Flow_DocsIncomplete</bpmn:incoming>
      <bpmn:outgoing>Flow_ResubmittedToDocCheck</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Lapsed" name="Application Lapsed (No Response)">
      <bpmn:incoming>Flow_DocLapsed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 3. Parallel Gateway Split: KYC, Credit Bureau, Income Checks -->
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Parallel Verification Split">
      <bpmn:incoming>Flow_DocsComplete</bpmn:incoming>
      <bpmn:outgoing>Flow_ToKYC</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBureau</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToIncome</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- 3a. KYC Service Task & Fraud Check (L2 & L3) -->
    <bpmn:serviceTask id="Task_KYCCheck" name="KYC &#38; AML Verification" camunda:type="external" camunda:topic="kyc-verification">
      <bpmn:incoming>Flow_ToKYC</bpmn:incoming>
      <bpmn:outgoing>Flow_KYCToGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_KYCResult" name="KYC / AML Status?">
      <bpmn:incoming>Flow_KYCToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_KYCPassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_KYCMismatch</bpmn:outgoing>
      <bpmn:outgoing>Flow_FraudHit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ManualKYCVerify" name="Manual Identity Check (Loan Officer)" camunda:candidateGroups="loan-officers">
      <bpmn:incoming>Flow_KYCMismatch</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualKYCDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- L3: Fraud / AML Investigation Sub-process & Terminate Event -->
    <bpmn:userTask id="Task_FraudInvestigation" name="Fraud Investigation Sub-process" camunda:candidateGroups="compliance">
      <bpmn:incoming>Flow_FraudHit</bpmn:incoming>
      <bpmn:outgoing>Flow_FraudConfirmed</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_FraudTerminate" name="Terminated: Fraud / Sanctions Hit">
      <bpmn:incoming>Flow_FraudConfirmed</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDef_Fraud" />
    </bpmn:endEvent>

    <!-- 3b. Credit Bureau Fetch with Error Boundary Event (L4) -->
    <bpmn:serviceTask id="Task_CreditBureau" name="Fetch Credit Score from Bureau" camunda:type="external" camunda:topic="credit-bureau-fetch">
      <bpmn:incoming>Flow_ToBureau</bpmn:incoming>
      <bpmn:outgoing>Flow_BureauDone</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- L4: Error Boundary Event for Bureau Timeout / Downtime -->
    <bpmn:boundaryEvent id="BoundaryError_Bureau" name="L4: Bureau Timeout / Outage" attachedToRef="Task_CreditBureau">
      <bpmn:outgoing>Flow_BureauError</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDef_Bureau" errorRef="Error_BureauTimeout" />
    </bpmn:boundaryEvent>

    <bpmn:userTask id="Task_ManualCreditCheck" name="Manual Credit Verification Fallback" camunda:candidateGroups="loan-officers">
      <bpmn:incoming>Flow_BureauError</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualCreditDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 3c. Income Verification -->
    <bpmn:userTask id="Task_IncomeCheck" name="Verify Income &#38; Employment (Loan Officer)" camunda:candidateGroups="loan-officers">
      <bpmn:incoming>Flow_ToIncome</bpmn:incoming>
      <bpmn:outgoing>Flow_IncomeDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway Join -->
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Parallel Verification Join">
      <bpmn:incoming>Flow_KYCPassed</bpmn:incoming>
      <bpmn:incoming>Flow_ManualKYCDone</bpmn:incoming>
      <bpmn:incoming>Flow_BureauDone</bpmn:incoming>
      <bpmn:incoming>Flow_ManualCreditDone</bpmn:incoming>
      <bpmn:incoming>Flow_IncomeDone</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinToScoring</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- 4. Eligibility & Risk Scoring (L5, L6) -->
    <bpmn:businessRuleTask id="Task_RiskScoring" name="Eligibility &#38; Risk Scoring" camunda:decisionRef="loan-risk-scoring">
      <bpmn:incoming>Flow_JoinToScoring</bpmn:incoming>
      <bpmn:outgoing>Flow_ScoringToGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_RiskRouting" name="Risk Tier Decision?">
      <bpmn:incoming>Flow_ScoringToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManualReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_RejectScore</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_RejectedScore" name="Application Rejected (Low Score)">
      <bpmn:incoming>Flow_RejectScore</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 5. Underwriter Review & Inclusive Gateway for High-Value Checks (L7, L8) -->
    <bpmn:userTask id="Task_UnderwriterReview" name="Underwriter Case Review" camunda:candidateGroups="underwriters">
      <bpmn:incoming>Flow_ManualReview</bpmn:incoming>
      <bpmn:outgoing>Flow_UnderwriterToInclusive</bpmn:outgoing>
    </bpmn:userTask>

    <!-- L7: Inclusive Gateway for High-Value / Senior Committee Checks -->
    <bpmn:inclusiveGateway id="Gateway_HighValueCheck" name="High-Value / Borderline Check?">
      <bpmn:incoming>Flow_UnderwriterToInclusive</bpmn:incoming>
      <bpmn:outgoing>Flow_StandardUnderwriting</bpmn:outgoing>
      <bpmn:outgoing>Flow_SeniorCommitteeEscalate</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:userTask id="Task_SeniorCommitteeApproval" name="Senior Credit Committee Approval (SLA Timer)" camunda:candidateGroups="credit-committee">
      <bpmn:incoming>Flow_SeniorCommitteeEscalate</bpmn:incoming>
      <bpmn:outgoing>Flow_SeniorCommitteeApproved</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:inclusiveGateway id="Gateway_HighValueJoin" name="High-Value Join">
      <bpmn:incoming>Flow_StandardUnderwriting</bpmn:incoming>
      <bpmn:incoming>Flow_SeniorCommitteeApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_UnderwritingApproved</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- 6. Offer Generation & Dispatch -->
    <bpmn:scriptTask id="Task_GenerateOffer" name="Generate Loan Offer Document" scriptFormat="javascript">
      <bpmn:incoming>Flow_AutoApprove</bpmn:incoming>
      <bpmn:incoming>Flow_UnderwritingApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_OfferToSend</bpmn:outgoing>
      <bpmn:script>execution.setVariable("offerReady", true);</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:sendTask id="Task_SendOffer" name="Send Loan Offer to Applicant" camunda:type="external" camunda:topic="send-loan-offer">
      <bpmn:incoming>Flow_OfferToSend</bpmn:incoming>
      <bpmn:outgoing>Flow_SendToAcceptance</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- 7. Offer Acceptance with 15-Day Timer Boundary (L9) -->
    <bpmn:receiveTask id="Task_AcceptOffer" name="Accept Loan Offer" messageRef="Message_OfferAccepted">
      <bpmn:incoming>Flow_SendToAcceptance</bpmn:incoming>
      <bpmn:outgoing>Flow_OfferAcceptedToEsign</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- L9: 15-Day Timer Boundary Event -->
    <bpmn:boundaryEvent id="BoundaryTimer_OfferValidity" name="L9: Offer Validity (15 Days)" attachedToRef="Task_AcceptOffer">
      <bpmn:outgoing>Flow_OfferExpired</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_OfferValidity">
        <bpmn:timeDuration>P15D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:endEvent id="EndEvent_OfferExpired" name="End: Offer Expired">
      <bpmn:incoming>Flow_OfferExpired</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 8. E-Sign Agreement (L11) -->
    <bpmn:userTask id="Task_EsignAgreement" name="E-Sign Loan Agreement" camunda:candidateGroups="applicants">
      <bpmn:incoming>Flow_OfferAcceptedToEsign</bpmn:incoming>
      <bpmn:outgoing>Flow_EsignToDisburse</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 9. Funds Disbursement & Account Creation (L12) -->
    <bpmn:serviceTask id="Task_DisburseFunds" name="Disburse Funds &#38; Create Loan Account" camunda:type="external" camunda:topic="disburse-loan-funds">
      <bpmn:incoming>Flow_EsignToDisburse</bpmn:incoming>
      <bpmn:outgoing>Flow_DisburseToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 10. End Event: Loan Disbursed -->
    <bpmn:endEvent id="EndEvent_LoanDisbursed" name="End: Loan Disbursed &#38; Active">
      <bpmn:incoming>Flow_DisburseToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToSubmit" sourceRef="StartEvent_LoanSubmitted" targetRef="Task_SubmitApplication" />
    <bpmn:sequenceFlow id="Flow_SubmitToDocCheck" sourceRef="Task_SubmitApplication" targetRef="Task_DocCheck" />
    <bpmn:sequenceFlow id="Flow_DocToCheckGateway" sourceRef="Task_DocCheck" targetRef="Gateway_DocCheckResult" />
    <bpmn:sequenceFlow id="Flow_DocsComplete" name="Docs Complete" sourceRef="Gateway_DocCheckResult" targetRef="Gateway_ParallelSplit" />
    <bpmn:sequenceFlow id="Flow_DocsIncomplete" name="L1: Incomplete Docs" sourceRef="Gateway_DocCheckResult" targetRef="Task_ResubmitDocs" />
    <bpmn:sequenceFlow id="Flow_ResubmittedToDocCheck" sourceRef="Task_ResubmitDocs" targetRef="Task_SubmitApplication" />
    <bpmn:sequenceFlow id="Flow_DocLapsed" sourceRef="Task_ResubmitDocs" targetRef="EndEvent_Lapsed" />

    <bpmn:sequenceFlow id="Flow_ToKYC" sourceRef="Gateway_ParallelSplit" targetRef="Task_KYCCheck" />
    <bpmn:sequenceFlow id="Flow_ToBureau" sourceRef="Gateway_ParallelSplit" targetRef="Task_CreditBureau" />
    <bpmn:sequenceFlow id="Flow_ToIncome" sourceRef="Gateway_ParallelSplit" targetRef="Task_IncomeCheck" />

    <bpmn:sequenceFlow id="Flow_KYCToGateway" sourceRef="Task_KYCCheck" targetRef="Gateway_KYCResult" />
    <bpmn:sequenceFlow id="Flow_KYCPassed" name="KYC OK" sourceRef="Gateway_KYCResult" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_KYCMismatch" name="L2: Identity Mismatch" sourceRef="Gateway_KYCResult" targetRef="Task_ManualKYCVerify" />
    <bpmn:sequenceFlow id="Flow_ManualKYCDone" sourceRef="Task_ManualKYCVerify" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_FraudHit" name="L3: Sanction / Fraud Hit" sourceRef="Gateway_KYCResult" targetRef="Task_FraudInvestigation" />
    <bpmn:sequenceFlow id="Flow_FraudConfirmed" sourceRef="Task_FraudInvestigation" targetRef="EndEvent_FraudTerminate" />

    <bpmn:sequenceFlow id="Flow_BureauDone" sourceRef="Task_CreditBureau" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_BureauError" name="L4: Timeout" sourceRef="BoundaryError_Bureau" targetRef="Task_ManualCreditCheck" />
    <bpmn:sequenceFlow id="Flow_ManualCreditDone" sourceRef="Task_ManualCreditCheck" targetRef="Gateway_ParallelJoin" />

    <bpmn:sequenceFlow id="Flow_IncomeDone" sourceRef="Task_IncomeCheck" targetRef="Gateway_ParallelJoin" />

    <bpmn:sequenceFlow id="Flow_JoinToScoring" sourceRef="Gateway_ParallelJoin" targetRef="Task_RiskScoring" />
    <bpmn:sequenceFlow id="Flow_ScoringToGateway" sourceRef="Task_RiskScoring" targetRef="Gateway_RiskRouting" />
    <bpmn:sequenceFlow id="Flow_AutoApprove" name="Low Risk: Auto-Approve" sourceRef="Gateway_RiskRouting" targetRef="Task_GenerateOffer" />
    <bpmn:sequenceFlow id="Flow_ManualReview" name="Medium Risk: Underwriting" sourceRef="Gateway_RiskRouting" targetRef="Task_UnderwriterReview" />
    <bpmn:sequenceFlow id="Flow_RejectScore" name="L5/L6: High Risk / Reject" sourceRef="Gateway_RiskRouting" targetRef="EndEvent_RejectedScore" />

    <bpmn:sequenceFlow id="Flow_UnderwriterToInclusive" sourceRef="Task_UnderwriterReview" targetRef="Gateway_HighValueCheck" />
    <bpmn:sequenceFlow id="Flow_StandardUnderwriting" name="Standard Amount" sourceRef="Gateway_HighValueCheck" targetRef="Gateway_HighValueJoin" />
    <bpmn:sequenceFlow id="Flow_SeniorCommitteeEscalate" name="L7: High Value / Borderline" sourceRef="Gateway_HighValueCheck" targetRef="Task_SeniorCommitteeApproval" />
    <bpmn:sequenceFlow id="Flow_SeniorCommitteeApproved" sourceRef="Task_SeniorCommitteeApproval" targetRef="Gateway_HighValueJoin" />
    <bpmn:sequenceFlow id="Flow_UnderwritingApproved" sourceRef="Gateway_HighValueJoin" targetRef="Task_GenerateOffer" />

    <bpmn:sequenceFlow id="Flow_OfferToSend" sourceRef="Task_GenerateOffer" targetRef="Task_SendOffer" />
    <bpmn:sequenceFlow id="Flow_SendToAcceptance" sourceRef="Task_SendOffer" targetRef="Task_AcceptOffer" />
    <bpmn:sequenceFlow id="Flow_OfferExpired" sourceRef="BoundaryTimer_OfferValidity" targetRef="EndEvent_OfferExpired" />
    <bpmn:sequenceFlow id="Flow_OfferAcceptedToEsign" sourceRef="Task_AcceptOffer" targetRef="Task_EsignAgreement" />
    <bpmn:sequenceFlow id="Flow_EsignToDisburse" sourceRef="Task_EsignAgreement" targetRef="Task_DisburseFunds" />
    <bpmn:sequenceFlow id="Flow_DisburseToEnd" sourceRef="Task_DisburseFunds" targetRef="EndEvent_LoanDisbursed" />
  </bpmn:process>

  <bpmn:error id="Error_BureauTimeout" name="BureauTimeoutError" errorCode="ERR_BUREAU_TIMEOUT" />
  <bpmn:message id="Message_OfferAccepted" name="Message_OfferAccepted" />

  <bpmndi:BPMNDiagram id="BPMNDiagram_Loan">
    <bpmndi:BPMNPlane id="BPMNPlane_Loan" bpmnElement="Collaboration_Loan">
      <bpmndi:BPMNShape id="Participant_Bank_di" bpmnElement="Participant_Bank" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2450" height="980" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Applicant_di" bpmnElement="Lane_Applicant" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2420" height="140" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_LoanOfficer_di" bpmnElement="Lane_LoanOfficer" isHorizontal="true">
        <dc:Bounds x="190" y="220" width="2420" height="140" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Underwriter_di" bpmnElement="Lane_Underwriter" isHorizontal="true">
        <dc:Bounds x="190" y="360" width="2420" height="140" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Fraud_di" bpmnElement="Lane_Fraud" isHorizontal="true">
        <dc:Bounds x="190" y="500" width="2420" height="140" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CreditBureau_di" bpmnElement="Lane_CreditBureau" isHorizontal="true">
        <dc:Bounds x="190" y="640" width="2420" height="140" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CoreBanking_di" bpmnElement="Lane_CoreBanking" isHorizontal="true">
        <dc:Bounds x="190" y="780" width="2420" height="140" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Disbursement_di" bpmnElement="Lane_Disbursement" isHorizontal="true">
        <dc:Bounds x="190" y="920" width="2420" height="140" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

      <!-- FlowNodes in Lane_Applicant -->
      <bpmndi:BPMNShape id="StartEvent_LoanSubmitted_di" bpmnElement="StartEvent_LoanSubmitted">
        <dc:Bounds x="230" y="130" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="205" y="173" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitApplication_di" bpmnElement="Task_SubmitApplication">
        <dc:Bounds x="300" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ResubmitDocs_di" bpmnElement="Task_ResubmitDocs">
        <dc:Bounds x="440" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Lapsed_di" bpmnElement="EndEvent_Lapsed">
        <dc:Bounds x="580" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="555" y="175" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AcceptOffer_di" bpmnElement="Task_AcceptOffer">
        <dc:Bounds x="1950" y="110" width="100" height="80" />
